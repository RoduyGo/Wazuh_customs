<group name="local,brute_force,">
<!-- 60122 (0580-win-security_rules.xml): Event 4625, đăng nhập Windows thất bại. -->
<!-- 60104 (0580-win-security_rules.xml): Sự kiện Windows audit failure chung, dùng cho Event 4771, 4768, 4776 trên AD. -->
<!-- 5710 (0095-sshd_rules.xml): SSH đăng nhập bằng tài khoản không tồn tại. -->
<!-- 5716, 5760 (0095-sshd_rules.xml): SSH xác thực thất bại (sai mật khẩu). -->
<!-- 60106 (0580-win-security_rules.xml): Event 4624, đăng nhập Windows thành công. -->
<!-- 5715 (0095-sshd_rules.xml): SSH đăng nhập thành công (dòng "Accepted"). -->

  <!-- Rule nền: mỗi lần đăng nhập sai -->
  <rule id="100110" level="5">
    <if_sid>60122</if_sid>
    <field name="win.eventdata.logonType">^3$|^8$|^10$</field>
    <description>INFO: Windows network/RDP logon failure for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress).</description>
    <options>no_full_log</options>
    <group>soc_logon_fail_win,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <rule id="100111" level="5">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^4771$|^4768$|^4776$</field>
    <field name="win.eventdata.status" type="pcre2">(?i)^0x(18|12|6|c000006a|c0000064|c0000234|c0000072)$</field>
    <description>INFO: Domain controller authentication failure (event $(win.system.eventID)) for $(win.eventdata.targetUserName).</description>
    <options>no_full_log</options>
    <group>soc_logon_fail_win,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <rule id="100112" level="5">
    <if_sid>5710,5716,5760</if_sid>
    <match negate="yes">^Disconnected from|^Connection closed by|^Received disconnect</match>
    <description>INFO: SSH authentication failure from $(srcip).</description>
    <group>soc_logon_fail_linux,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <!-- Rule tương quan: Windows và Domain Controller -->
  <rule id="100113" level="10" frequency="10" timeframe="120">
    <if_matched_group>soc_logon_fail_win</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <field name="win.eventdata.ipAddress" type="pcre2">^\d{1,3}(\.\d{1,3}){3}$|:</field>
    <field name="win.eventdata.ipAddress" type="pcre2" negate="yes">^127\.|^::1$|^::ffff:127\.</field>
    <list field="win.eventdata.ipAddress" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>NOTICE: Windows brute force: 10 failed logons in 120 seconds from $(win.eventdata.ipAddress) (last account: $(win.eventdata.targetUserName)).</description>
    <options>no_full_log</options>
    <group>soc_bf_alert_win,authentication_failures,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>


  <rule id="100115" level="12" frequency="6" timeframe="600">
    <if_matched_group>soc_logon_fail_win</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <different_field>win.eventdata.targetUserName</different_field>
    <field name="win.eventdata.ipAddress" type="pcre2">^\d{1,3}(\.\d{1,3}){3}$|:</field>
    <field name="win.eventdata.ipAddress" type="pcre2" negate="yes">^127\.|^::1$|^::ffff:127\.</field>
    <list field="win.eventdata.ipAddress" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>WARNING: Possible password spraying: $(win.eventdata.ipAddress) failed to log on with several different accounts in 10 minutes (last account: $(win.eventdata.targetUserName)).</description>
    <options>no_full_log</options>
    <group>soc_bf_alert_win,authentication_failures,</group>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>


  <rule id="100116" level="11" frequency="20" timeframe="900">
    <if_matched_group>soc_logon_fail_win</if_matched_group>
    <same_field>win.eventdata.targetUserName</same_field>
    <global_frequency />
    <field name="win.eventdata.targetUserName" type="pcre2" negate="yes">^-?$|\$$</field>
    <list field="win.eventdata.targetUserName" lookup="not_match_key">etc/lists/soc-allow-account</list>
    <description>NOTICE: Account $(win.eventdata.targetUserName) failed to log on 20 times in 15 minutes on monitored Windows hosts (possible distributed brute force).</description>
    <options>no_full_log</options>
    <group>authentication_failures,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>


  <rule id="100118" level="10" frequency="30" timeframe="3600">
    <if_matched_group>soc_logon_fail_win</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <global_frequency />
    <field name="win.eventdata.ipAddress" type="pcre2">^\d{1,3}(\.\d{1,3}){3}$|:</field>
    <field name="win.eventdata.ipAddress" type="pcre2" negate="yes">^127\.|^::1$|^::ffff:127\.</field>
    <list field="win.eventdata.ipAddress" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>NOTICE: Slow or multi-host brute force: $(win.eventdata.ipAddress) failed 30 logons in 1 hour across monitored Windows hosts.</description>
    <options>no_full_log</options>
    <group>soc_bf_alert_win,authentication_failures,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <!-- Rule tương quan: SSH trên Linux -->
  <rule id="100114" level="10" frequency="10" timeframe="120">
    <if_matched_group>soc_logon_fail_linux</if_matched_group>
    <same_source_ip />
    <list field="srcip" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>NOTICE: SSH brute force: 10 failed logins in 120 seconds from $(srcip) (valid and invalid users counted together).</description>
    <group>soc_bf_alert_linux,authentication_failures,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>


  <rule id="100117" level="11" frequency="20" timeframe="900">
    <if_matched_group>soc_logon_fail_linux</if_matched_group>
    <same_user />
    <global_frequency />
    <list field="user" lookup="not_match_key">etc/lists/soc-allow-account</list>
    <description>NOTICE: SSH account $(dstuser) failed to log in 20 times in 15 minutes on monitored Linux hosts (possible distributed brute force).</description>
    <group>authentication_failures,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>


  <rule id="100119" level="10" frequency="30" timeframe="3600">
    <if_matched_group>soc_logon_fail_linux</if_matched_group>
    <same_source_ip />
    <global_frequency />
    <list field="srcip" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>NOTICE: Slow or multi-host SSH brute force: $(srcip) failed 30 logins in 1 hour across monitored Linux hosts.</description>
    <group>soc_bf_alert_linux,authentication_failures,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <!-- Windows: đăng nhập thành công (4624) sau nhiều lần sai -->
  <rule id="100120" level="13" frequency="6" timeframe="600">
    <if_sid>60106</if_sid>
    <if_matched_group>soc_logon_fail_win</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <global_frequency />
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$|^8$|^10$</field>
    <field name="win.eventdata.ipAddress" type="pcre2">^\d{1,3}(\.\d{1,3}){3}$|:</field>
    <field name="win.eventdata.ipAddress" type="pcre2" negate="yes">^127\.|^::1$|^::ffff:127\.</field>
    <list field="win.eventdata.ipAddress" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>WARNING: Successful logon of $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress) after at least 5 failed logons from the same source in 10 minutes.</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>


  <rule id="100121" level="13" frequency="11" timeframe="900">
    <if_sid>60106</if_sid>
    <if_matched_group>soc_logon_fail_win</if_matched_group>
    <same_field>win.eventdata.targetUserName</same_field>
    <global_frequency />
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$|^8$|^10$</field>
    <field name="win.eventdata.targetUserName" type="pcre2" negate="yes">^-?$|\$$</field>
    <list field="win.eventdata.targetUserName" lookup="not_match_key">etc/lists/soc-allow-account</list>
    <description>WARNING: Successful logon of $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress) after at least 10 failed logons on this account in 15 minutes.</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>


  <rule id="100122" level="13" timeframe="3600">
    <if_sid>60106</if_sid>
    <if_matched_group>soc_bf_alert_win</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <global_frequency />
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$|^8$|^10$</field>
    <field name="win.eventdata.ipAddress" type="pcre2">^\d{1,3}(\.\d{1,3}){3}$|:</field>
    <list field="win.eventdata.ipAddress" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>WARNING: Successful logon of $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress) within 1 hour after a brute force alert from the same source.</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>


  <!-- Linux: đăng nhập SSH thành công sau nhiều lần sai -->
  <rule id="100123" level="13" frequency="6" timeframe="600">
    <if_sid>5715</if_sid>
    <if_matched_group>soc_logon_fail_linux</if_matched_group>
    <same_source_ip />
    <global_frequency />
    <list field="srcip" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>WARNING: SSH login of $(dstuser) from $(srcip) succeeded after at least 5 failed attempts from the same source in 10 minutes.</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>


  <rule id="100124" level="13" frequency="11" timeframe="900">
    <if_sid>5715</if_sid>
    <if_matched_group>soc_logon_fail_linux</if_matched_group>
    <same_user />
    <global_frequency />
    <list field="user" lookup="not_match_key">etc/lists/soc-allow-account</list>
    <description>WARNING: SSH login of $(dstuser) from $(srcip) succeeded after at least 10 failed attempts on this account in 15 minutes.</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>


  <rule id="100125" level="13" timeframe="3600">
    <if_sid>5715</if_sid>
    <if_matched_group>soc_bf_alert_linux</if_matched_group>
    <same_source_ip />
    <global_frequency />
    <list field="srcip" lookup="not_address_match_key">etc/lists/soc-allow-ip</list>
    <description>WARNING: SSH login of $(dstuser) from $(srcip) within 1 hour after a brute force alert from the same source.</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>




</group>
